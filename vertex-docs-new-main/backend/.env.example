SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=720
DATABASE_URL=sqlite:///./vertex_docs.db
# Optional one-off SQLite-to-Supabase migration connection. Keep it only in backend/.env;
# migration tooling reads this without changing the application's DATABASE_URL.
# SUPABASE_MIGRATION_URL=
# Supabase Postgres: copy the Session pooler URI from Dashboard > Connect and replace
# the SQLite value above. The backend accepts postgres:// and postgresql:// URIs.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
CORS_ORIGINS=http://localhost:5173,http://localhost:5175
MAX_UPLOAD_MB=50
LLM_API_KEY=
# Any OpenAI-compatible endpoint works. OpenRouter example (free multilingual model):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=inclusionai/ling-3.2-flash:free
# Free OpenRouter models may be given as a comma-separated list; a working model is picked in order.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
